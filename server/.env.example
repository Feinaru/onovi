# ============================================
# Onovi Server Environment Configuration
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Local development example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/onovi_dev"
#
# Render.com example:
# DATABASE_URL="postgresql://user:pass@dpg-xxxxx.oregon-postgres.render.com/dbname"
DATABASE_URL="postgresql://postgres:password@localhost:5432/onovi_dev"

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Port for the Express server
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# --------------------------------------------
# Authentication & Security
# --------------------------------------------
# JWT secret for token signing (MUST be changed in production)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET="change-this-secret-in-production"

# JWT expiration time (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# --------------------------------------------
# External APIs (Optional)
# --------------------------------------------
# User agent for Nominatim geocoding API
NOMINATIM_USER_AGENT="Onovi-Israel-Address-App/1.0"

# --------------------------------------------
# CORS Configuration (Optional)
# --------------------------------------------
# Allowed origins for CORS (comma-separated)
# Leave empty to allow all origins in development
# CORS_ORIGIN="https://onovi.com,https://www.onovi.com"
CORS_ORIGIN=

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable features
# ENABLE_EMAIL_NOTIFICATIONS=false
# ENABLE_SMS_NOTIFICATIONS=false

# --------------------------------------------
# Logging (Optional)
# --------------------------------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# --------------------------------------------
# Rate Limiting (Optional)
# --------------------------------------------
# API rate limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
