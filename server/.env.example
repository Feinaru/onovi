# ============================================
# Lomea Server Environment Configuration
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Local development example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/lomea_dev"
#
# Render.com example:
# DATABASE_URL="postgresql://user:pass@dpg-xxxxx.oregon-postgres.render.com/dbname"
DATABASE_URL="postgresql://postgres:password@localhost:5432/lomea_dev"

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Port for the Express server
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# --------------------------------------------
# Authentication & Security
# --------------------------------------------
# JWT secret for token signing (MUST be changed in production)
# Generate a secure random string: openssl rand -base64 32
# The server refuses to start in production if this is missing or left as a
# known placeholder value.
JWT_SECRET=replace_me_with_strong_secret

# JWT expiration time (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# --------------------------------------------
# External APIs (Optional)
# --------------------------------------------
# User agent for Nominatim geocoding API
NOMINATIM_USER_AGENT="Lomea-Israel-Address-App/1.0"

# --------------------------------------------
# CORS Configuration (Optional)
# --------------------------------------------
# Allowed origins for CORS (comma-separated).
# When empty in development, the local Vite origins are allowed by default.
# In production this MUST be set to the real frontend origin(s).
# Production example: CORS_ORIGIN="https://lomea.com,https://www.lomea.com"
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable features
# ENABLE_EMAIL_NOTIFICATIONS=false
# ENABLE_SMS_NOTIFICATIONS=false

# --------------------------------------------
# Logging (Optional)
# --------------------------------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# --------------------------------------------
# Rate Limiting (Optional)
# --------------------------------------------
# API rate limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
