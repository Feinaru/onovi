# ============================================
# Lomea Client Environment Configuration
# ============================================

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Backend API URL (read by the client as VITE_API_BASE_URL)
# Local development: http://localhost:3000
# Production: https://lomea-api.onrender.com (example)
VITE_API_BASE_URL=http://localhost:3000

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable features in the frontend
# VITE_ENABLE_MAPS=true
# VITE_ENABLE_ANALYTICS=false

# --------------------------------------------
# Map Configuration (Optional)
# --------------------------------------------
# Default map center coordinates (Israel)
# VITE_MAP_CENTER_LAT=31.7683
# VITE_MAP_CENTER_LNG=35.2137
# VITE_MAP_DEFAULT_ZOOM=13

# --------------------------------------------
# Analytics (Optional)
# --------------------------------------------
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX
