# Render Blueprint for Lomea - FREE TIER (Testing Only)
# ⚠️ WARNING: Database expires after 90 days
# Monthly Cost: $0 (but database will be deleted after 90 days)
# Use only for: Short-term testing, demos, proof of concepts

# Database - FREE (⚠️ EXPIRES AFTER 90 DAYS)
databases:
  - name: lomea-db-free
    databaseName: lomea_free
    user: lomea_free
    region: oregon
    plan: free  # $0/month - ⚠️ EXPIRES AFTER 90 DAYS, NO BACKUPS
    ipAllowList: []

# Backend API Service - FREE (Sleeps after 15 min)
services:
  - type: web
    name: lomea-api-free
    env: node
    region: oregon
    plan: free  # $0/month - Sleeps after 15 min inactivity
    buildCommand: cd server && npm install && npx prisma generate
    startCommand: cd server && npm run db:migrate && npm start
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: lomea-db-free
          property: connectionString
      - key: NODE_ENV
        value: development
      - key: PORT
        value: 3000
      - key: JWT_SECRET
        generateValue: true
      - key: JWT_EXPIRES_IN
        value: 7d
      - key: NOMINATIM_USER_AGENT
        value: Lomea-Free-Test-App/1.0
    healthCheckPath: /

  # Frontend Static Site - FREE (Always free)
  - type: web
    name: lomea-client-free
    env: static
    buildCommand: cd client && npm install && npm run build
    staticPublishPath: ./client/dist
    pullRequestPreviewsEnabled: true
    headers:
      - path: /*
        name: X-Frame-Options
        value: DENY
      - path: /*
        name: X-Content-Type-Options
        value: nosniff
      - path: /*
        name: Referrer-Policy
        value: strict-origin-when-cross-origin
    routes:
      - type: rewrite
        source: /*
        destination: /index.html

# ⚠️ CRITICAL LIMITATIONS:
#
# Database (free plan):
# - EXPIRES AFTER 90 DAYS (data will be DELETED)
# - No backups
# - 256 MB RAM
# - 1 GB storage
# - 1 connection only
#
# Backend (free plan):
# - Sleeps after 15 minutes of inactivity
# - Cold start: 30-60 seconds on first request
# - 512 MB RAM
# - Shares 750 build hours/month with all your free services
#
# Frontend (free plan):
# - Always free (no limitations)
# - 100 GB bandwidth/month
#
# TOTAL COST: $0/month
#
# ⚠️ USE ONLY FOR:
# - Short-term testing (< 90 days)
# - Feature demos
# - Proof of concepts
# - Quick bug reproduction
#
# ❌ DO NOT USE FOR:
# - Staging environment
# - Long-term testing
# - Client demos requiring reliability
# - Any environment where data loss is unacceptable
#
# RECOMMENDATION:
# After testing, upgrade to render.yaml.staging ($7/month) for persistent database
